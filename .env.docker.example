# BitCentral Docker Environment Configuration Example
# Copy this file to .env or reference in docker-compose.yml

# Database Settings
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=bitcentral
MYSQL_USER=bitcentral_user
MYSQL_PASSWORD=your_secure_db_password

# Client API Base URL (Used during container build for Vite)
# If serving via reverse proxy or same domain, set to '/api' or 'http://your-server-ip:8080'
VITE_API_BASE_URL=http://localhost:8080

# Backend Server Settings
PORT=8080
GIN_MODE=release
SKIP_SERVICE_INIT=false

# MCP Server Settings
MCP_PORT=8081
