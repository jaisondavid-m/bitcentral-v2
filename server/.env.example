# ==============================================================================
# BitCentral V2 - Server Environment Variables Example
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

PORT=8080

INTERNAL_API_SECRET=replace_with_internal_service_secret

# ------------------------------------------------------------------------------
# DATABASE 1: PRIMARY / CORE DATABASE (Auth, Users, Admins, Security)
# Handles: users, admins, allowed_emails, tracker_users, ps_tokens
# ------------------------------------------------------------------------------
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your_core_db_user.root
MYSQL_PASSWORD=your_core_db_password
MYSQL_DATABASE=bitcentral
MYSQL_SSL_ENABLED=true
MYSQL_SSL_CA_PATH=isrgrootx1.pem
MYSQL_TOKEN_TABLE=ps_tokens

# ------------------------------------------------------------------------------
# DATABASE 2: ACADEMIC & CONTENT DATABASE (Read-Heavy Portal Services)
# Handles: cards, mess_menu_items, semester_subjects, qb_answer_keys,
#          college_leaves, faculty_directory, faculty_details, sponsor_* tables
# (If omitted, automatically falls back to DB 1 Primary Database)
# ------------------------------------------------------------------------------
MYSQL_ACADEMIC_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_ACADEMIC_PORT=4000
MYSQL_ACADEMIC_USER=your_academic_db_user.root
MYSQL_ACADEMIC_PASSWORD=your_academic_db_password
MYSQL_ACADEMIC_DATABASE=bitcentral_academic
MYSQL_ACADEMIC_SSL_ENABLED=true
MYSQL_ACADEMIC_SSL_CA_PATH=isrgrootx1.pem

# ------------------------------------------------------------------------------
# DATABASE 3: LOGS & HIGH-WRITE FREE DATABASE (Audit & Interactive Community)
# Dedicated free DB cluster for write-heavy data to protect primary quotas.
# Handles: audit_logs (API request logs), daily_active_user_stats, feedback_messages,
#          help_rooms, help_messages, help_participants, help_reports, help_blocks,
#          notifications, user_notification_reads, user_notification_dismissals,
#          email_job_batches, email_queue_items, admin_sent_emails, lost_found_*
# (If omitted, automatically falls back to DB 1 Primary Database)
# ------------------------------------------------------------------------------
MYSQL_LOGS_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_LOGS_PORT=4000
MYSQL_LOGS_USER=your_free_logs_db_user.root
MYSQL_LOGS_PASSWORD=your_free_logs_db_password
MYSQL_LOGS_DATABASE=bitcentral_logs
MYSQL_LOGS_SSL_ENABLED=true
MYSQL_LOGS_SSL_CA_PATH=isrgrootx1.pem

# Optional: Set to true to re-run table migrations across all databases
FORCE_DB_MIGRATIONS=false

# Optional: Set to true to skip MySQL & OAuth initialization for offline testing
SKIP_SERVICE_INIT=false

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_strong_32_byte_random_secret
# ------------------------------------------------------------------------------
# GOOGLE OAUTH & SHEETS INTEGRATION
# ------------------------------------------------------------------------------
CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CONTACTS_REDIRECT_URI=http://localhost:8080/auth/callback
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:8080/auth/callback,https://your-domain.com/auth/callback
REDIRECT_URL=http://localhost:8080/auth/callback
SPREADSHEET_ID=your_rewards_spreadsheet_id
RP_Detailed_sheet=your_rp_detailed_sheet_id
RP_Detailed_sheet_2=your_rp_detailed_sheet_2_id
GOOGLE_SERVICE_ACCOUNT_KEY=https://api.bitcentral.bitsathy.in/server/sa-key.json

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Sponsors & Contributions)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ------------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Image Uploads & Lost and Found)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=bitcentral/lost_found

# ------------------------------------------------------------------------------
# SMTP EMAIL SENDER CONFIGURATION (Gomail & Notification Batches)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=developer@bitsathy.in
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="BIT Central"
SMTP_FROM_EMAIL=developer@bitsathy.in
SMTP_INSECURE_SKIP_VERIFY=false

# ------------------------------------------------------------------------------
# HUGGING FACE API (Internal Marks Conversion)
# ------------------------------------------------------------------------------
HF_TOKEN=hf_your_hugging_face_token

# ------------------------------------------------------------------------------
# CLOUDFLARE PAGES API (Deployment & Analytics Monitoring)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_PAGES_PROJECT_NAME=bitcentral-v2
