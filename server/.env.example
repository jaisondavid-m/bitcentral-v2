# Local development example environment variables
# Copy this file to .env and replace placeholder values.

PORT=8080

# TiDB Cloud MySQL configuration
MYSQL_USER=your_tidb_user.root
MYSQL_PASSWORD=your_tidb_password
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=bitcentral
MYSQL_TOKEN_TABLE=ps_tokens
MYSQL_SSL_ENABLED=true
MYSQL_SSL_CA_PATH=isrgrootx1.pem

# Google OAuth / Analytics / Sheets configuration
CLIENT_ID=dummy-client-id.apps.googleusercontent.com
CLIENT_SECRET=dummy-client-secret
GOOGLE_OAUTH_CLIENT_ID=dummy-contacts-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=dummy-contacts-client-secret
GOOGLE_CONTACTS_REDIRECT_URI=http://localhost:8080/auth/callback
REDIRECT_URL=http://localhost:8080/auth/callback
SPREADSHEET_ID=dummy-sheet-id
RP_Detailed_sheet=dummy-rp-detailed-sheet-id
RP_Detailed_sheet_2=dummy-rp-detailed-sheet-2-id
BOYS_MESS_SPREADSHEET_ID=dummy-boys-sheet-id
GIRLS_MESS_SPREADSHEET_ID=dummy-girls-sheet-id

# Optional: skip MySQL init for local testing with dummy env values
SKIP_SERVICE_INIT=true

# PS API Cookie configuration
PS_COOKIE_HEADER="PS=your_ps_cookie_value_here; Device-Identifier=your_device_identifier_here;"
PS_REWARDS_BREAKDOWN_BASE_URL=https://ps.bitsathy.ac.in/api/ps_v2/activity/rewards/breakdown

# Admin & Payment configuration
JWT_SECRET=replace_with_a_strong_32_byte_random_secret
INTERNAL_API_SECRET=replace_with_shared_mcp_internal_secret
ADMIN_DASHBOARD_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary configuration (for Lost & Found / image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bitcentral/lost_found

# Self Ping configuration
SELF_PING_INTERVAL_MS=600000
SELF_PING_URL=

# SMTP Email Sender configuration (Gomail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=developer@bitsathy.in
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME="BitCentral Admin"

# Hugging Face API Token (for higher rate limits on internal marks conversion)
HF_TOKEN=
SMTP_FROM_EMAIL=developer@bitsathy.in
SMTP_INSECURE_SKIP_VERIFY=false

# Cloudflare Pages API Configuration
# Get API Token with Pages:Read or Pages:Edit permissions from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=bitcentral-v2
