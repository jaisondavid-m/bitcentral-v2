# BitCentral MCP Server Configuration
PORT=8081

# BitCentral Backend API URL (for local dev or Render production backend)
BACKEND_URL=http://localhost:8080
# BACKEND_URL=https://bitcentral.bitsathy.in

# Optional Auth Token if backend endpoints require an API token
BACKEND_AUTH_TOKEN=

# Transport mode: "sse" (default for web/Render) or "stdio" (for local CLI/desktop)
MCP_TRANSPORT=sse

# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Google Custom Search (for BitBot AI web search)
# Get API key: https://console.cloud.google.com → Enable "Custom Search API" → Create Key
GOOGLE_SEARCH_API_KEY=212dsfas
# CX = Search Engine ID from https://programmablesearchengine.google.com
GOOGLE_SEARCH_CX=21adsf